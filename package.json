{
  "name": "network-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web + backend toolkit: DNS lookup, IP info, subnet calculator, HTTP header inspector",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:*\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "start": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "dotenv": "^18.0.4",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
